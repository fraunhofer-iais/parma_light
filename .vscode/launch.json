{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "server",
      "type": "debugpy",
      "request": "launch",
      "program": "src/parma/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "HOST_OPERATING_SYSTEM": "windows"
      }
    },
    {
      "name": "Python: Remote Attach",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/app" // Container path where code runs
        }
      ]
    }
  ]
}
