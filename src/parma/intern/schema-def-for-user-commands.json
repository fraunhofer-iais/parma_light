{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "alphanumeric_name": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
    },
    "data_name": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
      "description": "Name of a data entry: like alphanumeric_name, but may start with '_' too."
    },
    "version_pattern": {
      "type": "string",
      "pattern": "^(latest|[0-9]+)$"
    },
    "hash_pattern": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "path_pattern": {
      "type": "string",
      "pattern": "^(?:[a-zA-Z]:\\\\|\\\\\\\\|/)?([^<>:\"|?*]+[\\\\/])*[^<>:\"|?*]+$",
      "description": "A valid file path that supports both Linux and Windows formats."
    },
    "name_version": {
      "type": "object",
      "description": "Reference to a stored entity (data, node, workflow, run) by name and version. Hashes are not accepted.",
      "properties": {
        "name": {
          "$ref": "#/$defs/data_name"
        },
        "version": {
          "$ref": "#/$defs/version_pattern"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "wf_branch_def": {
      "type": "object",
      "description": "A branch (then or else) of an if node of a workflow: a node or a sub workflow with its channel renamings.",
      "properties": {
        "node": {
          "$ref": "#/$defs/name_version"
        },
        "workflow": {
          "$ref": "#/$defs/name_version"
        },
        "input": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_]*$": {
              "$ref": "#/$defs/alphanumeric_name"
            }
          },
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_]*$": {
              "$ref": "#/$defs/alphanumeric_name"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "input",
        "output"
      ],
      "oneOf": [
        { "required": ["node"], "not": { "required": ["workflow"] } },
        { "required": ["workflow"], "not": { "required": ["node"] } }
      ],
      "additionalProperties": false
    },
    "nix_uri_or_nix_hash": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "description": "A valid nix uri."
        },
        "hash": {
          "type": "string",
          "description": "A valid nix hash."
        }
      },
      "oneOf": [
        {
          "required": [
            "uri"
          ]
        },
        {
          "required": [
            "hash"
          ]
        }
      ],
      "additionalProperties": false
    },
    "type_def": {
      "type": "string",
      "enum": [
        "file",
        "directory",
        "environment_var",
        "str",
        "int",
        "float",
        "bool",
        "json"
      ]
    },
    "bool_def": {
      "type": "string",
      "enum": [
        "true",
        "false"
      ]
    },
    "storage_def": {
      "type": "string",
      "enum": [
        "platform",
        "extern"
      ]
    },
    "format_def": {
      "type": "string",
      "enum": [
        "json",
        "str",
        "any"
      ]
    },
    "full_channel_def": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/type_def"
        },
        "format": {
          "$ref": "#/$defs/format_def"
        },
        "storage": {
          "$ref": "#/$defs/storage_def"
        },
        "hash": {
          "$ref": "#/$defs/bool_def"
        },
        "user_path": {
          "$ref": "#/$defs/path_pattern"
        },
        "litegraph": {
          "$ref": "#/$defs/litegraph_def"
        }
      },
      "required": [
        "type",
        "format"
      ],
      "additionalProperties": false
    },
    "user_def": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/alphanumeric_name"
        },
        "admin": {
          "type": "boolean"
        },
        "password": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "admin",
        "password"
      ],
      "additionalProperties": false
    },
    "data_def": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/data_name"
        },
        "type": {
          "$ref": "#/$defs/type_def"
        },
        "storage": {
          "$ref": "#/$defs/storage_def"
        },
        "hash": {
          "$ref": "#/$defs/bool_def"
        },
        "format": {
          "$ref": "#/$defs/format_def"
        },
        "user_path": {
          "$ref": "#/$defs/path_pattern"
        }
      },
      "required": [
        "name",
        "type",
        "storage",
        "hash",
        "format",
        "user_path"
      ],
      "additionalProperties": false
    },
    "node_def": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/alphanumeric_name"
        },
        "image": {
          "$ref": "#/$defs/name_version"
        },
        "bash": {
          "$ref": "#/$defs/name_version"
        },
        "nix": {
          "$ref": "#/$defs/nix_uri_or_nix_hash"
        },
        "input": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_]*$": {
              "type": "object",
              "properties": {
                "type": {
                  "$ref": "#/$defs/type_def"
                },
                "format": {
                  "$ref": "#/$defs/format_def"
                },
                "path_in_container": {
                  "$ref": "#/$defs/path_pattern"
                },
                "environment_var_in_container": {
                  "$ref": "#/$defs/alphanumeric_name"
                },
                "command_line_parameter": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "format"
              ],
              "oneOf": [
                {
                  "required": [
                    "path_in_container"
                  ]
                },
                {
                  "required": [
                    "environment_var_in_container"
                  ]
                },
                {
                  "required": [
                    "command_line_parameter"
                  ]
                }
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_]*$": {
              "type": "object",
              "properties": {
                "type": {
                  "$ref": "#/$defs/type_def"
                },
                "format": {
                  "$ref": "#/$defs/format_def"
                },
                "path_in_container": {
                  "$ref": "#/$defs/path_pattern"
                },
                "environment_var_in_container": {
                  "$ref": "#/$defs/alphanumeric_name"
                },
                "command_line_parameter": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "format"
              ],
              "oneOf": [
                {
                  "required": [
                    "path_in_container"
                  ]
                },
                {
                  "required": [
                    "environment_var_in_container"
                  ]
                },
                {
                  "required": [
                    "command_line_parameter"
                  ]
                }
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "input",
        "output"
      ],
      "oneOf": [
        {
          "required": [
            "image"
          ]
        },
        {
          "required": [
            "bash"
          ]
        },
        {
          "required": [
            "nix"
          ]
        }
      ],
      "additionalProperties": false
    },
    "workflow_def": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/alphanumeric_name"
        },
        "input": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_]*$": {
              "type": "object",
              "properties": {
                "type": {
                  "$ref": "#/$defs/type_def"
                },
                "format": {
                  "$ref": "#/$defs/format_def"
                },
                "litegraph": {
                  "$ref": "#/$defs/litegraph_def"
                }
              },
              "required": [
                "type",
                "format"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_]*$": {
              "$ref": "#/$defs/full_channel_def"
            }
          },
          "additionalProperties": false
        },
        "bind": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_]*$": {
              "type": "object",
              "properties": {
                "type": {
                  "$ref": "#/$defs/type_def"
                },
                "format": {
                  "$ref": "#/$defs/format_def"
                },
                "data": {
                  "$ref": "#/$defs/name_version"
                },
                "environment_var_value": {
                  "type": "string"
                },
                "value": {
                  "description": "the constant bound to a channel of type str, int, float, bool or json"
                },
                "litegraph": {
                  "$ref": "#/$defs/litegraph_def"
                }
              },
              "required": [
                "type",
                "format"
              ],
              "oneOf": [
                {
                  "required": [
                    "data"
                  ]
                },
                {
                  "required": [
                    "environment_var_value"
                  ]
                },
                {
                  "required": [
                    "value"
                  ]
                }
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "connect": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_]*$": {
              "$ref": "#/$defs/full_channel_def"
            }
          },
          "additionalProperties": false
        },
        "nodes": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_]*$": {
              "type": "object",
              "properties": {
                "node": {
                  "$ref": "#/$defs/name_version"
                },
                "workflow": {
                  "$ref": "#/$defs/name_version"
                },
                "input": {
                  "type": "object",
                  "patternProperties": {
                    "^[a-zA-Z][a-zA-Z0-9_]*$": {
                      "$ref": "#/$defs/alphanumeric_name"
                    }
                  },
                  "additionalProperties": false
                },
                "output": {
                  "type": "object",
                  "patternProperties": {
                    "^[a-zA-Z][a-zA-Z0-9_]*$": {
                      "$ref": "#/$defs/alphanumeric_name"
                    }
                  },
                  "additionalProperties": false
                },
                "if": {
                  "$ref": "#/$defs/alphanumeric_name"
                },
                "then": {
                  "$ref": "#/$defs/wf_branch_def"
                },
                "else": {
                  "$ref": "#/$defs/wf_branch_def"
                },
                "litegraph": {
                  "$ref": "#/$defs/litegraph_def"
                }
              },
              "oneOf": [
                {
                  "required": ["node", "input", "output"],
                  "not": { "anyOf": [ {"required": ["workflow"]}, {"required": ["if"]}, {"required": ["then"]}, {"required": ["else"]} ] }
                },
                {
                  "required": ["workflow", "input", "output"],
                  "not": { "anyOf": [ {"required": ["node"]}, {"required": ["if"]}, {"required": ["then"]}, {"required": ["else"]} ] }
                },
                {
                  "required": ["if", "then", "else"],
                  "not": { "anyOf": [ {"required": ["node"]}, {"required": ["workflow"]}, {"required": ["input"]}, {"required": ["output"]} ] }
                }
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "input",
        "output",
        "bind",
        "connect",
        "nodes"
      ],
      "additionalProperties": false
    },
    "refine_def": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/alphanumeric_name"
        },
        "workflow": {
          "$ref": "#/$defs/name_version"
        },
        "replace_by_node": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_]*$": {
              "$ref": "#/$defs/name_version"
            }
          },
          "additionalProperties": false
        },
        "replace_by_workflow": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_]*$": {
              "$ref": "#/$defs/name_version"
            }
          },
          "additionalProperties": false
        },
        "replace_bind": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z][a-zA-Z0-9_]*$": {
              "type": "object",
              "properties": {
                "type": {
                  "$ref": "#/$defs/type_def"
                },
                "format": {
                  "$ref": "#/$defs/format_def"
                },
                "data": {
                  "$ref": "#/$defs/name_version"
                },
                "environment_var_value": {
                  "type": "string"
                },
                "value": {
                  "description": "the constant bound to a channel of type str, int, float, bool or json"
                },
                "litegraph": {
                  "$ref": "#/$defs/litegraph_def"
                }
              },
              "required": [
                "type",
                "format"
              ],
              "oneOf": [
                {
                  "required": [
                    "data"
                  ]
                },
                {
                  "required": [
                    "environment_var_value"
                  ]
                },
                {
                  "required": [
                    "value"
                  ]
                }
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "workflow"
      ],
      "additionalProperties": false
    },
    "run_def": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/alphanumeric_name"
        },
        "workflow": {
          "$ref": "#/$defs/name_version"
        }
      },
      "required": [
        "name",
        "workflow"
      ],
      "additionalProperties": false
    },
    "position_def": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "position [x, y] of a node on the canvas of the workflow editor"
    },
    "litegraph_def": {
      "type": "object",
      "properties": {
        "pos": {
          "$ref": "#/$defs/position_def"
        },
        "state": {
          "enum": [
            "expanded",
            "collapsed"
          ],
          "description": "state of the node on the canvas. Default: expanded"
        }
      },
      "additionalProperties": false,
      "description": "optional layout data of the workflow editor (LiteGraph)"
    }
  }
}